# Source for the MachineConfig embedded in
# manifests/21-nodepool-config-core-password.yaml
#   butane worker-core-password.bu -o 99-worker-core-password.yaml
# Generate the hash (SHA-512 crypt), never commit the clear password:
#   openssl passwd -6
#   (or: mkpasswd -m SHA-512)
variant: openshift
version: 4.18.0
metadata:
  name: 99-worker-core-password
  labels:
    machineconfiguration.openshift.io/role: worker
passwd:
  users:
    - name: core
      password_hash: '<CORE_PASSWORD_HASH>'
